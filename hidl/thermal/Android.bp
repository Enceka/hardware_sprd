cc_binary {
    name: "android.hardware.thermal@2.0-service.sprd",
    defaults: ["hidl_defaults"],
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.thermal@2.0-service.sprd.rc"],
    srcs: ["service.cpp", "Thermal.cpp"],
    shared_libs: [
        "android.hardware.thermal@1.0",
        "android.hardware.thermal@2.0",
        "libbase",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
