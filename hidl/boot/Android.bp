// Experimental empty-interface services; deliberately outside the product namespace.
soong_namespace {
    imports: ["hardware/sprd/interfaces"],
}

cc_binary {
    name: "vendor.sprd.hardware.boot@1.2-service.stub",
    defaults: ["hidl_defaults"],
    init_rc: ["vendor.sprd.hardware.boot@1.2-service.stub.rc"],
    vintf_fragments: ["vendor.sprd.hardware.boot@1.2-service.stub.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: ["service.cpp"],
    shared_libs: [
        "libbase",
        "libhidlbase",
        "liblog",
        "libutils",
        "vendor.sprd.hardware.boot@1.2",
    ],
}
