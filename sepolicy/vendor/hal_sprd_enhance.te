# The stock enhancement service is a separate AIDL service used by HWC.
hal_attribute(sprd_enhance)
type vendor_hal_sprd_enhance_service, hal_service_type, protected_service, service_manager_type, vendor_service;
hal_attribute_service(hal_sprd_enhance, vendor_hal_sprd_enhance_service)
binder_call(hal_sprd_enhance_client, hal_sprd_enhance_server)

type vendor_hal_sprd_enhance_default, domain;
type vendor_hal_sprd_enhance_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_hal_sprd_enhance_default)
hal_server_domain(vendor_hal_sprd_enhance_default, hal_sprd_enhance)
binder_use(vendor_hal_sprd_enhance_default)

hal_client_domain(hal_graphics_composer_default, hal_sprd_enhance)

# These stock clients load libpowerhal_cli.so, which uses the private AIDL
# extension registered by the standard power service process.
hal_client_domain(hal_graphics_composer_default, hal_power)
hal_client_domain(hal_audio_default, hal_power)
