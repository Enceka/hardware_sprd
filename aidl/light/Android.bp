// SPDX-License-Identifier: Apache-2.0
cc_binary {
    name: "android.hardware.lights-service.sprd",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["lights-sprd.rc"],
    vintf_fragments: ["lights-sprd.xml"],
    srcs: ["Lights.cpp", "main.cpp"],
    shared_libs: ["libbase", "libbinder_ndk", "android.hardware.light-V2-ndk"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
