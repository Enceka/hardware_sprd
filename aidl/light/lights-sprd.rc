service vendor.light-sprd /vendor/bin/hw/android.hardware.lights-service.sprd
    class hal
    user system
    group system
    shutdown critical

on post-fs-data
    chown system system /sys/class/backlight/sprd_backlight/brightness
    chmod 0660 /sys/class/backlight/sprd_backlight/brightness
    chown system system /sys/class/leds/keyboard-backlight/brightness
    chmod 0660 /sys/class/leds/keyboard-backlight/brightness

# The E5 display driver is a vendor_dlkm module and may probe after post-fs-data.
on property:vendor.all.modules.ready=1
    chown system system /sys/class/backlight/sprd_backlight/brightness
    chmod 0660 /sys/class/backlight/sprd_backlight/brightness
    chown system system /sys/class/leds/keyboard-backlight/brightness
    chmod 0660 /sys/class/leds/keyboard-backlight/brightness
