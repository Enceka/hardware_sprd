cc_binary {
    name: "android.hardware.power-service.sprd",
    vendor: true,
    relative_install_path: "hw",
    srcs: ["Power.cpp", "service.cpp"],
    shared_libs: ["android.hardware.power-V3-ndk", "libbase", "libbinder_ndk", "libperfmgr", "libutils"],
    init_rc: ["power.rc"],
    vintf_fragments: ["power.xml"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
