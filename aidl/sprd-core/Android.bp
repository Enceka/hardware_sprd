// Experimental empty-interface services; deliberately outside the product namespace.
soong_namespace {
    imports: ["hardware/sprd/interfaces"],
}

cc_binary {
    name: "vendor.sprd.hardware-aidl-service.stub",
    init_rc: ["vendor.sprd.hardware-aidl-service.stub.rc"],
    vintf_fragments: ["vendor.sprd.hardware-aidl-service.stub.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: ["service.cpp"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "vendor.sprd.hardware.aprd-V1-ndk",
        "vendor.sprd.hardware.cplog_svc-V1-ndk",
        "vendor.sprd.hardware.enhance-V1-ndk",
        "vendor.sprd.hardware.fingerprintmmi-V1-ndk",
        "vendor.sprd.hardware.hdcp-V1-ndk",
        "vendor.sprd.hardware.ifaa-V1-ndk",
        "vendor.sprd.hardware.log-V1-ndk",
        "vendor.sprd.hardware.network-V1-ndk",
        "vendor.sprd.hardware.soter-V1-ndk",
        "vendor.sprd.hardware.trusty-V1-ndk",
        "vendor.sprd.hardware.tui-V1-ndk",
    ],
}
