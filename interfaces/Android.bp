// Private API templates must never shadow the stock interface libraries when
// a product exports hardware/sprd for the standard HAL implementations.
soong_namespace {
}

hidl_package_root {
    name: "vendor.sprd.hardware",
    path: "hardware/sprd/interfaces/hidl",
}

hidl_package_root {
    name: "vendor.sw.swfingerprint",
    path: "hardware/sprd/interfaces/hidl_sw",
}
